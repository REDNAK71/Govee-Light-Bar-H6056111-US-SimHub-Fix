<UserControl x:Class="NitroRedNAK.GoveeBridge.NitroRedNAKGoveeBridgeSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Margin="16">
        <StackPanel>
            <TextBlock Text="NitroRedNAK Govee Bridge"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Govee light bar IP address"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="GoveeIpAddressTextBox"
                     Width="240"
                     Height="28"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Enter the local network IP address of your Govee light bars."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Button Content="Save IP Address"
                    Width="140"
                    Height="32"
                    HorizontalAlignment="Left"
                    Click="SaveIpAddressButton_Click"/>

            <TextBlock x:Name="StatusTextBlock"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
